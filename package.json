  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build && node scripts/test-built-css.mjs",
    "test:proxy": "node scripts/test-proxy-contracts.mjs",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:contracts": "npm run test:proxy",
    "test:integration": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageProvider=v8 && node scripts/write-coverage-metadata.mjs",
    "test:ci": "npm run test:contracts && npm run test:coverage -- --ci && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
