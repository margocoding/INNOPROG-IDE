server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 10m;
  # Room credentials are never written to this container's access log. The
  # outer proxy logs only the path configured by infrastructure, without args.
  access_log off;

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files /index.html =404;
  }

  location /static/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri =404;
  }

  location /bot-api/check/ {
    add_header Referrer-Policy "no-referrer" always;
    rewrite ^/bot-api/(.*)$ /$1 break;
    proxy_pass ${CODE_RUNNER_API_PROXY_URL};
    proxy_http_version 1.1;
    proxy_set_header Host ${CODE_RUNNER_API_PROXY_HOST};
    proxy_set_header Authorization "Bearer ${CODE_RUNNER_AUTH_TOKEN}";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
  }

  location /bot-api/code/run/ {
    add_header Referrer-Policy "no-referrer" always;
    rewrite ^/bot-api/(.*)$ /$1 break;
    proxy_pass ${CODE_RUNNER_API_PROXY_URL};
    proxy_http_version 1.1;
    proxy_set_header Host ${CODE_RUNNER_API_PROXY_HOST};
    proxy_set_header Authorization "Bearer ${CODE_RUNNER_AUTH_TOKEN}";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
  }

  location /bot-api/ {
    add_header Referrer-Policy "no-referrer" always;
    rewrite ^/bot-api/(.*)$ /$1 break;
    proxy_pass ${BOT_API_PROXY_URL};
    proxy_http_version 1.1;
    proxy_set_header Host ${BOT_API_PROXY_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
  }

  location = /health/live {
    access_log off;
    proxy_pass http://backend:3000/health/live;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
  }

  location = /health/ready {
    access_log off;
    proxy_pass http://backend:3000/health/ready;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
  }

  location / {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    add_header Referrer-Policy "no-referrer" always;
    try_files $uri $uri/ /index.html;
  }
}
